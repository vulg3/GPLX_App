{
  "expo": {
    "name": "Lý thuyết giao thông",
    "slug": "lythuyetgiaothong",
    "version": "1.5",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "gplxapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "sdkVersion": "53.0.0",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hault.ltgt",
      "appleTeamId": "LF5JJ2F6DY"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.hault.ltgt",
      "versionCode": 1,
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          },
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2615112087856757~4950144509",
          "iosAppId": "ca-app-pub-2615112087856757~1925146406"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#667eea"
        }
      ],
      "./plugins/withFmtFix"
    ],
    "extra": {
      "eas": {
        "projectId": "6f9ec095-6533-4007-a3ac-c28dcfea2cb8"
      }
    },
    "owner": "hault"
  }
}
